@page "/obs/"
@model Bison.Razor.Pages.PublicModel
@{
    ViewData["Title"] = "Bison";
    Layout = "Shared/_Layout";
}

<div>
    <h2> Public Timeline </h2>

        <form method="get">
        <label for="TaxonId">Filter by Taxon:</label>
        <select name="taxonId" id="TaxonId">
        <option value="">All Taxons</option>
        @foreach (var taxon in Model.Taxons)
        {
            <option value="@taxon.TaxonId" Selected="@(Model.SelectedTaxonId == taxon.TaxonId)">@(taxon.VernacularName ?? taxon.dwc_TaxonID)</option>
        }
        </select>
        <button type="submit">Filter</button>
        </form>

    
    @if (Model.Observations.Any())
    {
        <ul id="messagelist" class="observations">
            @foreach (var obs in Model.Observations)
            {
                <li>
                    <p>
                        <strong>
                            <a href="/@obs.Author">@obs.Author</a>
                        </strong>
                        @obs.Message
                        <small>&mdash; @obs.Timestamp</small>
                    </p>
                </li>
            }
        </ul>
    }
    else
    {
        <em>There are no observations so far.</em>
    }
</div>

@if (Model.CurrentPage > 1)
{
    <a href="@(Model.SelectedTaxonId != null ? $"?page={(Model.CurrentPage - 1)}&taxonId={(Model.SelectedTaxonId)}" : $"?page={(Model.CurrentPage - 1)}")">Previous</a>
}

<span>Page @Model.CurrentPage</span>

@if (Model.Observations.Count == 32)
{
    <a href="@(Model.SelectedTaxonId != null ? $"?page={(Model.CurrentPage + 1)}&taxonId={(Model.SelectedTaxonId)}" : $"?page={(Model.CurrentPage + 1)}")">Next</a>
}
