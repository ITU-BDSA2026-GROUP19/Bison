@page "/About"
@model Bison.Razor.Pages.AboutModel

<div>
    <h2>About Me</h2>
    <h3>Personal Information</h3>
    <p><strong>Name:</strong> @User.Identity.Name</p>
    <p><strong>Email:</strong> @User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value</p>

    <h3>My Observations</h3>
@if (Model.Observations.Any())
    {
        <ul id="observationList" class="observations">
            @foreach (var ob in Model.Observations)
            {
                <partial name="_Observation" model="ob" />
            }
        </ul>
    }
    else
    {
        <em>You have made no Observations so far.</em>
    }

    <h3>My Comments</h3>

    @if (Model.Comments.Any())
    {
        <ul id="commentList" class="comments">
            @foreach (var comment in Model.Comments)
            {
                <li>
                    <strong>@comment.Author</strong>
                    <p>@comment.Message</p>
                    <small>@comment.Timestamp</small>
                </li>
            }
        </ul>
    }
    else
    {
        <em>You have made no Comments so far.</em>
    }

    <h3>My Proposals</h3>

    @if (Model.Proposals.Any())
    {
        <ul id="proposalList" class="proposals">
            @foreach (var proposal in Model.Proposals)
            {
                <li>
                    <strong>@proposal.Author</strong>
                    <p>@proposal.TaxonName</p>
                    <small>@proposal.Timestamp</small>
                </li>
            }
        </ul>
    }
    else
    {
        <em>You have made no Proposals so far.</em>
    }
</div>

@if (Model.CurrentPage > 1)
{
    <a href="?page=@(Model.CurrentPage - 1)">Previous</a>
}

<span>Page @Model.CurrentPage</span>

@if (Model.Observations.Count == 32 || Model.Comments.Count == 32 || Model.Proposals.Count == 32)
{
    <a href="?page=@(Model.CurrentPage + 1)">Next</a>
}