@using Bison.Core
@using System.Security.Claims
@model ObservationViewModel

@{
    var authorEmail = User.FindFirstValue(ClaimTypes.Email);
    var isOwner = !string.IsNullOrEmpty(authorEmail)
                  && authorEmail == Model.AuthorEmail;
}

<li>
    @if (!string.IsNullOrEmpty(Model.PicturePath))
    {
        <img src="@Model.PicturePath"
             alt="Observation picture" />

        <p>License: @Model.PictureLicense</p>
    }

    <p>
        <strong>
            <a href="/@Model.Author">@Model.Author</a>
        </strong>
        @Model.Message
        <small>&mdash; @Model.Timestamp</small>
    </p>

    <a href="/ob/@Model.Id">View observation</a>

    @if (isOwner && string.IsNullOrEmpty(Model.PicturePath))
    {
        <form method="post" enctype="multipart/form-data">
            <input type="hidden" name="id" value="@Model.Id" />
            <input type="file" name="ImageFile" accept="image/*" required />

            <label for="PictureLicense-@Model.Id">Picture license:</label>
            <select id="PictureLicense-@Model.Id" name="PictureLicense" required>
                <option value="">Select a license...</option>
                <option value="CC BY 4.0">CC BY 4.0</option>
                <option value="CC BY-SA 4.0">CC BY-SA 4.0</option>
                <option value="CC BY-ND 4.0">CC BY-ND 4.0</option>
                <option value="CC BY-NC 4.0">CC BY-NC 4.0</option>
                <option value="CC BY-NC-SA 4.0">CC BY-NC-SA 4.0</option>
                <option value="CC BY-NC-ND 4.0">CC BY-NC-ND 4.0</option>
            </select>

            <button type="submit" asp-page-handler="UploadPicture">
                Upload picture
            </button>
        </form>
    }
</li>