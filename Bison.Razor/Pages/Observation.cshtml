@page "/ob/{id:int?}"
@model Bison.Razor.Pages.ObservationModel

<h2>Observation @Model.Observation.Id</h2>

<p>
    <strong>@Model.Observation.Author</strong>: @Model.Observation.Message
    <small>(@Model.Observation.Timestamp)</small>
</p>

@if (!string.IsNullOrEmpty(Model.Observation.PicturePath))
{
    <img src="@Model.Observation.PicturePath"
         alt="Observation picture"
         style="max-width: 500px;" />
}

@if (User.Identity?.IsAuthenticated == true)
{
    <form method="post" enctype="multipart/form-data">
        <input type="hidden" name="id" value="@Model.Observation.Id" />

        <input type="file" name="ImageFile" accept="image/*" />

        <button type="submit" asp-page-handler="UploadPicture">
            Upload picture
        </button>
    </form>
}

<h3>Proposals</h3>

@if (Model.Proposals.Count == 0)
{
    <p>No proposals yet.</p>
}

@foreach (var proposal in Model.Proposals)
{
    <p>
        <strong>@proposal.Author</strong> proposed taxon @proposal.TaxonId
        <small>(@proposal.Timestamp)</small>
    </p>
}

@if (User.Identity?.IsAuthenticated == true)
{
    <form method="post" asp-page-handler="CreateProposal">
        <input type="hidden" name="id" value="@Model.Observation.Id" />

        <select asp-for="SelectedTaxonId" required>
            <option value="">Select a taxon...</option>

            @foreach (var taxon in Model.Taxons)
            {
                <option value="@taxon.TaxonId">
                    @(taxon.VernacularName ?? taxon.dwc_TaxonID)
                </option>
            }
        </select>

        <button type="submit">Submit proposal</button>
    </form>
}

<h3>Comments</h3>

@if (Model.Comments.Count == 0)
{
    <p>No comments yet.</p>
}

@foreach (var comment in Model.Comments)
{
    <p>
        <strong>@comment.Author</strong>: @comment.Message
        <small>(@comment.Timestamp)</small>
    </p>
}
@if (User.Identity?.IsAuthenticated == true)
{
    <form method="post" asp-page-handler="CreateComment">
        <input type="hidden" name="id" value="@Model.Observation.Id" />

        <textarea asp-for="CommentText"
                  placeholder="Write your comment..."
                    required></textarea>
        <button type="submit">Submit comment</button>
    </form>
}