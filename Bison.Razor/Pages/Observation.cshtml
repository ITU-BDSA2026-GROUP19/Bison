@page "/ob/{id:int?}"
@model Bison.Razor.Pages.ObservationModel

<h2>Observation @Model.Observation.Id</h2>

<p>
    <strong>@Model.Observation.Author</strong>: @Model.Observation.Message
    <small>(@Model.Observation.Timestamp)</small>
</p>

<h3>Proposals</h3>

@if (Model.Proposals.Count == 0)
{
    <p>No proposals yet.</p>
}

@foreach (var proposal in Model.Proposals)
{
    <p>
        <strong>@proposal.Author</strong> proposed taxon @proposal.TaxonId
        <small>(@proposal.Timestamp)</small>
    </p>
}

<h3>Comments</h3>

@if (Model.Comments.Count == 0)
{
    <p>No comments yet.</p>
}

@foreach (var comment in Model.Comments)
{
    <p>
        <strong>@comment.Author</strong>: @comment.Message
        <small>(@comment.Timestamp)</small>
    </p>
}